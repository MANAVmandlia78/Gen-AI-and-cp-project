# ========================================================
# Maharaja Tours & Travels - Environment Configuration Example
# Copy this file to .env and configure keys for production.
# Note: In development mode, the system runs with deterministic
# verified multi-agent synthesizers and meteorological models.
# ========================================================

# Server Port
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maharaja_tours

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin Default Credentials
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@maharajatours.com
ADMIN_PASSWORD=admin123
ADMIN_PHONE=+919876543210

# Generative AI & LLM Provider (Google Gemini / OpenAI)
# Keys remain strictly on the backend and are NEVER exposed to client-side code.
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector Database & Embedding Configuration
EMBEDDING_API_KEY=
VECTOR_DATABASE_URL=

# External Tool APIs (Optional - Ground truth fallback matrix is active)
WEATHER_API_KEY=
MAPS_API_KEY=

# Email / Nodemailer Configuration (Optional)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
